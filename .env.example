# Copy to .env for local development. On Vercel, add the same names under
# Project -> Settings -> Environment Variables. Never commit real values.

# ---------- Public (inlined into the browser bundle at BUILD time) ----------
# Supabase dashboard -> Project Settings -> API. Set them before building.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------- Server-only: NEVER prefix with VITE_ ----------
# Supabase secret (service-role) key: used by server functions (adding athletes, Zoom).
SUPABASE_SECRET_KEY=
# Only for scripts/*.ts (applying migrations). Not needed on Vercel.
SUPABASE_DB_URL=

# ---------- Zoom (server-only) ----------
# Zoom Marketplace -> your General App -> Basic Information -> App Credentials.
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Must EXACTLY match a Redirect URL registered in the Zoom app (and its OAuth Allow List):
#   local:      http://localhost:8080/api/zoom/callback
#   production: https://<your-domain>/api/zoom/callback
ZOOM_REDIRECT_URI=
# Zoom app -> Features -> Access -> Event Subscription -> Secret Token.
ZOOM_WEBHOOK_SECRET_TOKEN=
# 32 random bytes, base64. Encrypts stored Zoom tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it later disconnects every coach's Zoom (they reconnect once).
ZOOM_TOKEN_ENCRYPTION_KEY=
