# Public — safe to expose in the browser bundle (Vite injects VITE_* vars).
# Supabase dashboard -> Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Server-only — NEVER prefix with VITE_, never import from client code.
# Used only by scripts/*.ts (e.g. applying migrations, admin tasks).
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres
