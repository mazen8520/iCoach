# Keep local secrets and build output out of `vercel deploy` uploads (Vercel builds remotely).
.env
.env.*
!.env.example
node_modules
.output
.vercel
.tanstack
.nitro
dist
# Native mobile projects and their sources: built by .github/workflows/mobile-apps.yml, not Vercel.
# Anchored to the root: a bare "assets" would also drop src/assets (the app's photos).
/android
/ios
/mobile
/assets
# Local tool settings
/.claude
/.impeccable
